# Get a key from https://console.anthropic.com/settings/keys
# Used by api/claude.js on the server — never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase project settings -> API (console.supabase.com -> your project -> Settings -> API)
# The anon key is safe to expose to the browser — Row Level Security policies
# (see supabase/schema.sql) enforce who can read/write what.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
